{
  "opencollection": "1.0.0",
  "info": {
    "name": "BetterCloud Platform Events API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BetterCloud List Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bettercloud.com/v1/events",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "from",
                "value": "2026-04-01T00:00:00Z",
                "type": "query",
                "description": "Start date for event filter (ISO 8601)."
              },
              {
                "name": "to",
                "value": "2026-04-19T23:59:59Z",
                "type": "query",
                "description": "End date for event filter (ISO 8601)."
              },
              {
                "name": "type",
                "value": "user.suspended",
                "type": "query",
                "description": "Filter by event type."
              },
              {
                "name": "user_id",
                "value": "user-a1b2c3d4",
                "type": "query",
                "description": "Filter events for a specific user."
              }
            ]
          },
          "docs": "Returns a paginated list of audit events and activity logs."
        }
      ]
    }
  ],
  "bundled": true
}