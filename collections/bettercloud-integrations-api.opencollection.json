{
  "opencollection": "1.0.0",
  "info": {
    "name": "BetterCloud Platform Events Integrations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BetterCloud List Integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bettercloud.com/v1/integrations"
          },
          "docs": "Returns a list of all configured SaaS application integrations."
        }
      ]
    }
  ],
  "bundled": true
}