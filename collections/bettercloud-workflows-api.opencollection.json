{
  "opencollection": "1.0.0",
  "info": {
    "name": "BetterCloud Platform Events Workflows API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BetterCloud List Workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bettercloud.com/v1/workflows",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "status",
                "value": "active",
                "type": "query",
                "description": "Filter by workflow status."
              }
            ]
          },
          "docs": "Returns a paginated list of all automation workflows."
        },
        {
          "info": {
            "name": "BetterCloud Create Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bettercloud.com/v1/workflows",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new automation workflow."
        },
        {
          "info": {
            "name": "BetterCloud Get Workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bettercloud.com/v1/workflows/:id",
            "params": [
              {
                "name": "id",
                "value": "wf-100200",
                "type": "path",
                "description": "The unique identifier of the workflow."
              }
            ]
          },
          "docs": "Returns a single workflow by ID."
        },
        {
          "info": {
            "name": "BetterCloud Delete Workflow",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bettercloud.com/v1/workflows/:id",
            "params": [
              {
                "name": "id",
                "value": "wf-100200",
                "type": "path",
                "description": "The unique identifier of the workflow."
              }
            ]
          },
          "docs": "Deletes an automation workflow."
        },
        {
          "info": {
            "name": "BetterCloud Run Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bettercloud.com/v1/workflows/:id/run",
            "params": [
              {
                "name": "id",
                "value": "wf-100200",
                "type": "path",
                "description": "The unique identifier of the workflow."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Manually triggers a workflow execution for specified users."
        }
      ]
    }
  ],
  "bundled": true
}